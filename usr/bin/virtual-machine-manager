#!/usr/bin/env ruby

class VirtualMachineManager

  def initialize(virtual_machine)
    @virtual_machine = virtual_machine
  end

  def status
    response = `/usr/bin/virsh list --all`

    raise "Unexepect result for vm_status `#{$?.exitstatus}`" if $?.exitstatus != 0

    response.split("\n").each do |line|
      if matches = line.match(/#{@virtual_machine}\s+(.+)\Z/)
        return matches[1]
      end
    end

    return 'unknown'
  end

  def shutdown
    `/usr/bin/virsh shutdown #{@virtual_machine}`
  end

  def start
    `/usr/bin/virsh start #{@virtual_machine}`
  end
end

