#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "Usage: $0 <source_dir> <dest_dir> <base_filename> [--delete-source]"
    exit 1
}

SOURCE_DIR=""
DEST_DIR=""
BASE_NAME=""
DELETE_SOURCE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --delete-source)
            DELETE_SOURCE=true
            shift
            ;;
        *)
            if [[ -z "$SOURCE_DIR" ]]; then
                SOURCE_DIR="$1"
            elif [[ -z "$DEST_DIR" ]]; then
                DEST_DIR="$1"
            elif [[ -z "$BASE_NAME" ]]; then
                BASE_NAME="$1"
            else
                echo "Error: Unexpected argument '$1'"
                usage
            fi
            shift
            ;;
    esac
done

if [[ -z "$SOURCE_DIR" || -z "$DEST_DIR" || -z "$BASE_NAME" ]]; then
    echo "Error: Missing required arguments."
    usage
fi

if [[ ! -d "$SOURCE_DIR" ]]; then
    echo "Error: Source directory '$SOURCE_DIR' does not exist."
    exit 1
fi

mkdir -p "$DEST_DIR"

# Resolve absolute path and strip any trailing slash
SOURCE_DIR_ABS=$(cd "$SOURCE_DIR" && pwd)
DEST_DIR_ABS=$(cd "$DEST_DIR" && pwd)

# Get the last directory name (e.g., Dump)
FOLDER_NAME=$(basename "$SOURCE_DIR_ABS")

TAR_FILE="${DEST_DIR_ABS}/${BASE_NAME}.tar.gz"
LOG_FILE="${DEST_DIR_ABS}/${BASE_NAME}.log"

echo "Creating archive: ${TAR_FILE}"

# Change to SOURCE_DIR_ABS so only its contents are scanned.
# --transform prepends the root folder name to every file inside the tar.
tar -czvf "$TAR_FILE" \
    --transform "s|^\.|${FOLDER_NAME}|" \
    -C "$SOURCE_DIR_ABS" . > "$LOG_FILE"

echo "Archive created successfully."
echo "Log created: ${LOG_FILE}"

if [[ "$DELETE_SOURCE" == true ]]; then
    echo "Deleting source directory: ${SOURCE_DIR_ABS}"
    rm -rf "$SOURCE_DIR_ABS"
    echo "Source directory removed."
fi